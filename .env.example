# Slack app credentials (see README "Create the Slack app").
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Model backend: claude | codex | openai-compatible
GHOST_BACKEND=claude
# Optional model override for the chosen CLI (for example: sonnet, opus, gpt-5.6-terra).
GHOST_MODEL=
# Seconds before a model call is stopped.
GHOST_MODEL_TIMEOUT_SECONDS=180
# Maximum concurrent model calls.
GHOST_MAX_CONCURRENCY=2

# Only for GHOST_BACKEND=openai-compatible (a local subscription proxy).
GHOST_PROXY_URL=http://127.0.0.1:8317/v1
GHOST_PROXY_API_KEY=

# Local index.
GHOST_DB_PATH=./data/ghost.db
GHOST_BACKFILL_DAYS=365
GHOST_RESYNC_MINUTES=360

# Context budget in characters (thread + recent channel + retrieved history).
GHOST_CONTEXT_CHARS=24000

# Optional. Ghost already chats without a tag in any channel where you are the only human member.
# Set a channel name or ID here to force chat mode in that channel too.
GHOST_HOME_CHANNEL=

# debug | info | warn | error
GHOST_LOG_LEVEL=info
